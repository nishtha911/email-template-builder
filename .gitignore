# === MONOREPO: SERVER (Express + TS) =========================================
# Build outputs
server/node_modules/
server/dist/
server/build/
server/lib/
# TS incremental
server/*.tsbuildinfo
server/**/.tsbuildinfo
# Caches
server/.cache/
# Local env overrides
server/.env
server/.env.*

